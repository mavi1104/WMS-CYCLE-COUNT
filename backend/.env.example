# Django runtime
DJANGO_SECRET_KEY=YOUR_DJANGO_SECRET_KEY
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Existing Microsoft SQL Server database (schema is owned by the legacy WMS)
DB_NAME=YOUR_DATABASE_NAME
DB_HOST=localhost
DB_PORT=1433
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server

# true = Windows/Integrated authentication; false = DB_USER/DB_PASSWORD
DB_TRUSTED_CONNECTION=true

# For a trusted server certificate, keep false. Set true only for a local or
# internal certificate that your machine cannot validate yet.
DB_TRUST_SERVER_CERTIFICATE=false
DB_ENCRYPT=true

# Vue development origins. Add the deployed UI origin when it is known.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
